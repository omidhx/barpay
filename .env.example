# =============================================================================
# barnameh-pay — environment template
# COPY to .env and fill the values. Never commit a real .env (master spec 13.5).
# مرجع کامل متغیرها: docs/runbooks/onboard-new-customer.md و docs/runbooks/deploy.md
# =============================================================================

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/barnameh_pay
TZ=Asia/Tehran

# --- Feature flags (only these two exist — master spec 13.7) ---
# COMMITMENT_ENFORCEMENT: OFF | SHADOW | ENFORCED (stay OFF until legal text is approved)
COMMITMENT_ENFORCEMENT=OFF
SIGNED_URL_DOWNLOAD=OFF

# --- Encryption key for gateway credentials (AES-256-GCM, 32-byte, base64) ---
# Gateway credentials are stored ENCRYPTED in payment_gateways (DB) — only this key
# lives in the environment. Losing it = losing all gateway configs.
GATEWAY_CREDENTIALS_KEY=

# --- File storage (S3-compatible, private bucket) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- SMS providers (FrazSMS + MelliPayamk, auto-failover, circuit breaker) ---
# Exact parameter names: docs/integrations/sms-providers.md
FARAZSMS_API_KEY=
FARAZSMS_SENDER=
MELLIPAYAMK_API_KEY=
MELLIPAYAMK_SENDER=
SMS_DAILY_CAP=

# --- OTP ---
OTP_TTL_SECONDS=180
